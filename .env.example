# ── Strata Client Environment ─────────────────────────────────────────
#
# Copy to `.env` and edit. Every value shown is the code's actual
# default, so a line left commented out behaves exactly as written.
#
# Compose passes most of these through as `${VAR:-}`, which means a
# commented-out line still reaches the container as an EMPTY STRING
# rather than being unset. Where that distinction matters it is called
# out below.
#
# Anything marked REQUIRED has no default and the process refuses to
# start without it.


# ══ Compose ═══════════════════════════════════════════════════════════

# Overlays applied to every plain `docker compose` command. Separator is
# OS-specific: ';' on Windows, ':' on Linux/macOS.
#   docker-compose.vdi.yml       — VDI containers (adds the docker.sock mount)
#   docker-compose.internal.yml  — internal host of a two-host DMZ split
#   docker-compose.dmz.yml       — DMZ host of a two-host split
#COMPOSE_FILE=docker-compose.yml;docker-compose.vdi.yml

# Optional service profiles:
#   local-db — bundled PostgreSQL
#   av       — bundled ClamAV          https — Caddy + Let's Encrypt
#COMPOSE_PROFILES=local-db

# Prefixes containers, networks and volumes. Changing this after first
# boot orphans the existing volumes.
#COMPOSE_PROJECT_NAME=strata-client


# ══ Ports ═════════════════════════════════════════════════════════════

HTTP_PORT=80
HTTPS_PORT=443


# ══ Logging ═══════════════════════════════════════════════════════════

# `tracing` EnvFilter syntax. `strata_backend=debug,info` is the useful
# one when diagnosing a session.
RUST_LOG=info
#DMZ_RUST_LOG=info


# ══ Database ══════════════════════════════════════════════════════════

# Defaults to the bundled PostgreSQL. That default password is a known
# value, and the backend logs an ERROR on every boot until it changes —
# set POSTGRES_PASSWORD below, or point DATABASE_URL at your own server.
#DATABASE_URL=postgresql://strata:strata_default@postgres-local:5432/strata

# Bundled PostgreSQL credentials (profile `local-db`). DATABASE_URL must
# agree with these if you change them.
#POSTGRES_USER=strata
#POSTGRES_PASSWORD=strata_default
#POSTGRES_DB=strata

# TLS for an external database. DATABASE_SSL_MODE overrides any sslmode
# already present in DATABASE_URL.
# Values: disable, allow, prefer, require, verify-ca, verify-full
#DATABASE_SSL_MODE=require
#DATABASE_CA_CERT=/etc/strata/certs/pg-ca.pem

# Connection pool tuning.
#DATABASE_MAX_CONNECTIONS=20
#DATABASE_ACQUIRE_TIMEOUT_SECS=30
#DATABASE_IDLE_TIMEOUT_SECS=60
#DATABASE_MAX_LIFETIME_SECS=3600
#DATABASE_STATEMENT_TIMEOUT_MS=90000


# ══ Identity and bootstrap ════════════════════════════════════════════

# Created on first boot only. Change the password immediately after.
# If DEFAULT_ADMIN_PASSWORD is unset a random one is generated and written
# to /tmp/.strata-admin-password (mode 0600) inside the container.
DEFAULT_ADMIN_USERNAME=admin
#DEFAULT_ADMIN_PASSWORD=

# Signs session JWTs. Generated on first boot and persisted to
# config.toml when unset; set it explicitly to keep sessions valid across
# a rebuild, or to share it between replicas. Must decode to >= 32 bytes.
#   openssl rand -base64 32
#JWT_SECRET=

# One-shot bearer token required on the first /initialize call. Leave
# unset only if you can guarantee nobody reaches the instance before you
# finish setup — without it, initialisation is unauthenticated. 32+ chars.
#   openssl rand -base64 32
#STRATA_SETUP_TOKEN=

# Absolute base URL used to build SSO callback redirects. Derived from
# the Host / X-Forwarded-Proto headers when unset, which is wrong behind
# a proxy that rewrites either.
#BASE_URL=https://strata.example.com

# Host header allowlist. Blocks SSO redirect hijacking via a spoofed
# Host; unset means any Host is accepted.
#ALLOWED_HOSTS=strata.example.com,strata.internal.example.com

# Reported by /api/health. Falls back to NODE_ENV, then "production".
#STRATA_ENV=production

# Where the persisted TOML config lives inside the container.
#CONFIG_PATH=/app/config/config.toml

# Directory the admin certificate page scans, recursively.
#STRATA_CERT_DIR=/etc/strata/certs


# ══ CORS, WebSocket origins and proxies ═══════════════════════════════

# Comma-separated CORS allowlist. UNSET MEANS ANY ORIGIN IS ALLOWED —
# set this in production.
#STRATA_ALLOWED_ORIGINS=https://strata.example.com

# Origins permitted to open a session WebSocket. Inherits the HTTP CORS
# list when unset.
#STRATA_ALLOWED_WS_ORIGINS=https://strata.example.com

# Public domain for automatic Let's Encrypt TLS via Caddy.
# Requires: docker compose --profile https up -d
#STRATA_DOMAIN=strata.example.com

# X-Forwarded-For is IGNORED unless this is exactly `1`. Without it any
# client could forge the header to evade per-IP rate limits or poison the
# source IP recorded in the audit log.
#STRATA_TRUST_XFF=1

# CIDRs or bare IPs of proxies whose XFF is believed. XFF is honoured only
# when the socket peer is in this list; the chain is walked right to left
# past trusted hops. An empty list means XFF is ignored; an invalid entry
# stops the backend from starting.
#STRATA_TRUSTED_PROXIES=10.0.0.0/8,192.168.1.5


# ══ Session engine ════════════════════════════════════════════════════

# Protocols the engine may serve. LEAVE UNSET unless you are
# deliberately holding one back: unset tracks every compiled engine
# (rdp, ssh, vnc, kubernetes), so adding an engine needs no edit here.
# Naming them explicitly is how `kubernetes` once got left off the list,
# and an omitted protocol is refused, not served some other way.
#
# Blank counts as unset. Naming only unrecognised protocols does not:
# that restricts to nothing, and each bad entry is logged as a warning.
#STRATA_SESSION_NATIVE_PROTOCOLS=rdp,ssh,vnc,kubernetes

# Nameservers for target hostnames are NOT set here. They live in the
# admin Network tab, because the engine resolves targets itself rather
# than relying on the container's resolver — which has to stay pointed at
# Docker's embedded DNS to find postgres, vault and clamav.


# ══ Antivirus scanning ════════════════════════════════════════════════
#
# Applies to both Quick Share upload paths. The scanner runs on the
# streamed temp file BEFORE it reaches the session file store and before
# it is sealed via Vault Transit. Disabled by default, in which case the
# audit row records av_scan_status="skipped".
#
#   off      — no scanning (default)
#   clamav   — clamd over TCP (INSTREAM). Bundled sidecar:
#                docker compose --profile av up -d
#              First boot pulls ~250 MB of signatures via freshclam.
#   command  — any scanner using 0=clean / 1=infected / other=error
#STRATA_AV_BACKEND=off

#STRATA_AV_CLAMD_ADDR=clamav:3310

# `{path}` is replaced with the temp file path.
#STRATA_AV_COMMAND=/usr/local/bin/scan {path}

# What to do when the scanner itself fails (timeout, daemon down).
# INFECTED verdicts are always rejected regardless of this setting.
#   block — reject the upload (fail-closed, default)
#   allow — permit it; the audit row still records the error
#STRATA_AV_FAIL_MODE=block

# Larger files pass through unscanned, tagged Skipped{reason="oversize"}.
# Default 500 MB, matching the upload cap so every accepted upload is
# scanned. Raising it means tuning clamd.conf MaxFileSize / StreamMaxLength.
#STRATA_AV_MAX_SCAN_SIZE=524288000

# Per-scan wall-clock cap in ms. Exceeded scans become Error verdicts and
# are then subject to STRATA_AV_FAIL_MODE.
#STRATA_AV_TIMEOUT_MS=120000

# Staging directory for sealed outbound share blobs.
#STRATA_OUTBOUND_SHARES_DIR=/tmp/strata-outbound-shares


# ══ Web kiosk sessions ════════════════════════════════════════════════

# Master switch for the `web` protocol (Chromium kiosk behind Xvnc).
#STRATA_WEB_ENABLED=true

# Hostname the session engine uses to reach Xvnc. Must be this backend's
# compose service name so a sibling container can reach it.
#STRATA_WEB_VNC_HOST=backend

# Host directory of operator-supplied login automation scripts.
#WEB_LOGIN_SCRIPTS_DIR=./web-login-scripts


# ══ VDI sessions ══════════════════════════════════════════════════════

# Requires the docker-compose.vdi.yml overlay for the docker.sock mount.
#STRATA_VDI_ENABLED=false

# Docker network the spawned containers join. Override when
# COMPOSE_PROJECT_NAME prefixes the network name.
#STRATA_VDI_NETWORK=guac-internal

# Host path for persistent VDI home directories.
#VDI_HOME_BASE=./vdi-homes


# ══ Vault ═════════════════════════════════════════════════════════════
#
# Optional — can also be configured from the Admin UI after login.
# Credentials are sealed with the Transit key; without Vault they are
# encrypted with a locally held key instead.

#VAULT_ADDR=http://vault:8200
#VAULT_TOKEN=
#VAULT_TRANSIT_KEY=strata-master-key

# Only needed to auto-unseal the bundled Vault after a restart.
#VAULT_UNSEAL_KEY=


# ══ DMZ split topology — internal host ════════════════════════════════
#
# Only for the *internal* host of a two-host deployment. Apply with:
#   docker compose -f docker-compose.yml -f docker-compose.internal.yml up -d backend
#
# The overlay wires the cert paths and node/cluster IDs. The two secrets
# below must match the DMZ host's active `current:` PSK and its
# STRATA_DMZ_EDGE_HMAC_KEY. Leave commented for single-host runs.

#STRATA_DMZ_ENDPOINTS=strata-dmz:8444
#STRATA_DMZ_LINK_PSK_CURRENT=
#STRATA_DMZ_EDGE_HMAC_KEYS=

# Required once STRATA_DMZ_ENDPOINTS is set.
#STRATA_NODE_ID=internal-1
#STRATA_CLUSTER_ID=strata-cluster


# ══ DMZ split topology — DMZ host ═════════════════════════════════════
#
# These configure the separate `strata-dmz` daemon, not the backend.
# Every REQUIRED entry must be set or the daemon refuses to start.
# Apply with docker-compose.dmz.yml.

#STRATA_DMZ_PUBLIC_BIND=0.0.0.0:8443
#STRATA_DMZ_LINK_BIND=0.0.0.0:9443
#STRATA_DMZ_OPERATOR_BIND=127.0.0.1:9444

# REQUIRED — mTLS material for the link server.
#STRATA_DMZ_LINK_TLS_CERT=/etc/strata/certs/dmz/link.crt
#STRATA_DMZ_LINK_TLS_KEY=/etc/strata/certs/dmz/link.key
#STRATA_DMZ_LINK_CA_BUNDLE=/etc/strata/certs/dmz/internal-ca.pem

# REQUIRED — `id:base64key` pairs, comma-separated. The first entry is
# active; the rest stay accepted, so keys can be rotated without
# restarting both hosts at the same moment.
#STRATA_DMZ_LINK_PSKS=current:

# REQUIRED — signs the x-strata-edge-* headers. Must match the internal
# host's active STRATA_DMZ_EDGE_HMAC_KEYS entry.
#STRATA_DMZ_EDGE_HMAC_KEY=

# REQUIRED — handshakes with a mismatched cluster id are rejected.
#STRATA_DMZ_CLUSTER_ID=strata-cluster

# REQUIRED — bearer token for the operator listener, 32+ chars.
#STRATA_DMZ_OPERATOR_TOKEN=

# Public TLS. REQUIRED unless STRATA_DMZ_DEV is set, in which case the
# public listener serves plain HTTP instead.
#STRATA_DMZ_PUBLIC_TLS_CERT=/etc/strata/certs/public/fullchain.pem
#STRATA_DMZ_PUBLIC_TLS_KEY=/etc/strata/certs/public/privkey.pem

# Defaults to the system hostname.
#STRATA_DMZ_NODE_ID=

# Never set this outside a development machine: it makes public TLS
# optional and lets the link CA and PSKs load from filesystem defaults.
#STRATA_DMZ_DEV=1

# Upstream load balancers whose X-Forwarded-For is trusted. Empty means
# XFF is ignored entirely and the socket peer is used.
#STRATA_DMZ_TRUST_FORWARDED_FROM=10.0.0.0/8

# Abuse mitigation on the public listener.
#STRATA_DMZ_PUBLIC_BODY_LIMIT_BYTES=8388608
#STRATA_DMZ_PUBLIC_BODY_LIMITS_BY_IP=10.0.0.0/8=33554432
#STRATA_DMZ_PUBLIC_HEADER_TIMEOUT_MS=15000
#STRATA_DMZ_PUBLIC_MAX_INFLIGHT=4096
# Per-IP request rate; 0 disables rate limiting.
#STRATA_DMZ_PUBLIC_RATE_RPS=0
#STRATA_DMZ_PUBLIC_RATE_BURST=64

# Host ports published by docker-compose.dmz.yml.
#DMZ_PUBLIC_PORT=8443
#DMZ_LINK_PORT=9443
#DMZ_OPERATOR_PORT=9444
#DMZ_EDGE_HTTP_PORT=8080
#DMZ_EDGE_HTTPS_PORT=8444


# ══ Notes ═════════════════════════════════════════════════════════════
#
# Live-session integration tests read STRATA_{RDP,SSH,KUBE}_TEST_* and are
# #[ignore]d by default. They are documented in the test files themselves
# rather than here, because they never apply to a deployment.
#
# Changing anything in this file needs only a backend restart — no
# rebuild, no redeploy.
